#include <stdio.h>
#include <string.h>
#include <unistd.h>

/**
 * handle_builtin - checks if command is a built-in
 * @args: array of command arguments
 * @env: the environment array passed to main
 * Return: 1 if built-in was handled, 0 otherwise
 */
int handle_builtin(char **args, char **env)
{
  int i = 0;

  if (strcmp(args[0], "exit") == 0)
  {
    /* Perform cleanup and exit */
    exit(0);
  }

  if (strcmp(args[0], "env") == 0)
  {
    /* Print every entry in the environment array */
    while (env[i] != NULL)
    {
      /* Write to stdout */
      write(STDOUT_FILENO, env[i], strlen(env[i]));
      write(STDOUT_FILENO, "\n", 1);
      i++;
    }
    return (1); /* Indicate that a built-in was handled */
  }

  return (0); /* Not a built-in */
}

