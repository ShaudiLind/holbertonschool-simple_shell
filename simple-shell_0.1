#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <string.h>

/**
 * main - Simple shell execution loop
 * Return: 0 on success
 */
int main(void)
{
  char *buffer = NULL;
  size_t len = 0;
  ssize_t nread;
  pid_t pid;
  char *argv[] = {NULL, NULL}; /* Argument array for execve */

  while (1)
  {
    /* 1. Display Prompt */
    printf("#cisfun$ ");

    /* 2. Read Input */
    nread = getline(&buffer, &len, stdin);
    if (nread == -1) /* Handle EOF (Ctrl+D) */
    {
      printf("\n");
      break;
    }

    /* Remove the trailing newline character from input */
    if (buffer[nread - 1] == '\n')
      buffer[nread - 1] = '\0';

    /* Prepare arguments for execve */
    argv[0] = buffer;

    /* 3. Fork Process */
    pid = fork();
    if (pid == -1)
    {
      perror("Error:");
      return (1);
    }
    if (pid == 0)
    {
      /* Child process: Execute command */
      if (execve(argv[0], argv, NULL) == -1)
      {
        perror("Error");
        exit(1);
      }
    }
    else
    {
      /* Parent process: Wait for child */
      wait(NULL);
    }
  }
  free(buffer);
  return (0);
}

